 :host {
  display: block;
  min-height: 100vh;
  background: linear-gradient(180deg, #f3f7fb 0%, #edf3f9 100%);
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 74px;
  padding: 0 32px;
  background: linear-gradient(135deg, #0f172a 0%, #1d4e89 100%);
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.18);
}

.brand {
  font-size: clamp(1.5rem, 2vw, 2.2rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  color: #f8fbff;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.2);
  font-weight: 800;
  color: #ffffff;
}

.brand-text {
  font-size: clamp(1.3rem, 1.8vw, 1.8rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  color: #f8fbff;
}

.topbar nav {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.topbar nav a,
.logout-button {
  border: 0;
  border-radius: 10px;
  padding: 10px 16px;
  background: transparent;
  color: rgba(255, 255, 255, 0.8);
  font-size: 0.98rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.topbar nav a:hover,
.logout-button:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  text-decoration: none;
}

.topbar nav a.active {
  background: rgba(96, 165, 250, 0.18);
  color: #ffffff;
  box-shadow: inset 0 0 0 1px rgba(147, 197, 253, 0.45);
}

.logout-button {
  margin-left: 8px;
  background: rgba(191, 219, 254, 0.12);
}

.page-container {
  max-width: 1500px;
  margin: 0 auto;
  padding: 28px 20px 42px;
}

.page-card,
.login-card {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 18px;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(5px);
}

.login-card {
  max-width: 460px;
  margin: 56px auto;
  padding: 30px 28px 24px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(148, 163, 184, 0.25);
  border-radius: 24px;
  box-shadow: 0 22px 60px rgba(15, 23, 42, 0.16);
}

.login-card h2 {
  margin: 0 0 8px;
  color: #0f172a;
  font-size: clamp(2rem, 3vw, 2.5rem);
  text-align: center;
}

.login-header {
  text-align: center;
  margin-bottom: 20px;
}

.brand-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  border-radius: 18px;
  background: linear-gradient(135deg, #1d4ed8, #2563eb);
  color: #fff;
  font-size: 1.4rem;
  font-weight: 800;
  margin-bottom: 14px;
  box-shadow: 0 12px 26px rgba(37, 99, 235, 0.28);
}

.field {
  margin-bottom: 18px;
}

.field label {
  display: block;
  margin-bottom: 8px;
  color: #334155;
  font-weight: 700;
}

.field input,
.filters input,
.filters select,
.form-grid input,
.form-grid select,
.form-grid textarea,
.member-table input,
.member-table select {
  width: 100%;
  border: 1px solid #c6d3e4;
  border-radius: 12px;
  background: #ffffff;
  color: #0f172a;
  padding: 12px 14px;
  font: inherit;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.field input:focus,
.filters input:focus,
.filters select:focus,
.form-grid input:focus,
.form-grid select:focus,
.form-grid textarea:focus,
.member-table input:focus,
.member-table select:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
}

.login-card button,
.button,
.form-actions button,
.pager button {
  border: 0;
  border-radius: 12px;
  background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
  color: #ffffff;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.2s ease;
}

.login-card button {
  width: 100%;
  padding: 12px 16px;
  font-size: 1rem;
  box-shadow: 0 8px 22px rgba(37, 99, 235, 0.28);
}

.login-card button:hover,
.button:hover,
.form-actions button:hover,
.pager button:hover {
  transform: translateY(-1px);
}

.button {
  padding: 10px 16px;
}

.button.primary {
  background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
}

.demo-note {
  margin-top: 18px;
  color: #475569;
  text-align: center;
  line-height: 1.6;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px;
  padding-top: 14px;
  border-top: 1px solid #e2e8f0;
}

.error {
  padding: 12px 14px;
  border-radius: 10px;
  background: #fef2f2;
  color: #b91c1c;
  border: 1px solid #fecaca;
}

.page-heading {
  margin-bottom: 24px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.page-heading h1 {
  margin: 0 0 6px;
  color: #0f172a;
  font-size: clamp(1.8rem, 2vw, 2.5rem);
}

.page-heading p {
  margin: 0;
  color: #64748b;
}

.filters {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 18px;
}

.filters input {
  flex: 1 1 300px;
  min-width: 200px;
}

.filters select {
  flex: 0 0 180px;
}

table {
  width: 100%;
  border-collapse: collapse;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
}

th,
td {
  padding: 14px 12px;
  border-bottom: 1px solid #e2e8f0;
  text-align: left;
}

th {
  background: #f8fafc;
  color: #475569;
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

tbody tr:hover {
  background: #f8fbff;
}

.status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88px;
  padding: 6px 10px;
  border-radius: 999px;
  background: #dcfce7;
  color: #166534;
  font-size: 0.75rem;
  font-weight: 700;
}

.status.inactive {
  background: #e2e8f0;
  color: #475569;
}

.actions,.heading-actions,.form-actions,.pager {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.link-button {
  background: transparent;
  border: 0;
  color: #2563eb;
  font-weight: 600;
  cursor: pointer;
  padding: 0;
}

.danger-text {
  color: #b91c1c;
}

.pager {
  justify-content: flex-end;
  margin-top: 18px;
  color: #475569;
}

.form-card {
  max-width: 1100px;
  margin: 0 auto;
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px 22px;
}

.form-grid label {
  display: block;
  color: #334155;
  font-weight: 700;
}

.form-grid input,
.form-grid select,
.form-grid textarea {
  margin-top: 8px;
}

.full-width {
  grid-column: 1 / -1;
}

.member-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin: 28px 0 14px;
}

.member-heading h3,
.section-title {
  color: #123052;
  margin: 0;
}

.add-member-panel,
.details-grid {
  background: #f8fafc;
  border: 1px solid #dfeaf6;
  border-radius: 14px;
}

.add-member-panel {
  padding: 18px;
  margin-bottom: 18px;
}

.add-member-fields {
  display: grid;
  grid-template-columns: 2fr 1.5fr 1.2fr 1fr auto;
  gap: 10px;
  align-items: end;
  margin-top: 12px;
}

.details-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px 22px;
  padding: 18px;
}

.details-grid span {
  display: block;
  margin-bottom: 5px;
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #64748b;
}

.loading,
.empty {
  padding: 28px 12px;
  text-align: center;
  color: #64748b;
}

@media (max-width: 760px) {
  .topbar {
    padding: 14px 18px;
    align-items: flex-start;
    flex-direction: column;
    gap: 12px;
  }

  .page-container {
    padding: 18px 12px 28px;
  }

  .page-card,
  .login-card {
    padding: 18px 14px;
    border-radius: 14px;
  }

  .page-heading,
  .form-grid,
  .details-grid,
  .add-member-fields {
    grid-template-columns: 1fr;
    display: grid;
  }

  .page-heading {
    display: grid;
  }

  .filters {
    display: grid;
  }

  .pager {
    justify-content: space-between;
  }
}
