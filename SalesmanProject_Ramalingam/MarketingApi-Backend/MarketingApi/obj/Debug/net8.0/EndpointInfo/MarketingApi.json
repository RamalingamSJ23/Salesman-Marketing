  "components": {
    "schemas": {
      "CreateMarketingTeamDto": {
        "required": [
          "description",
          "members",
          "teamcode",
          "teamleaderid",
          "teamname"
        ],
        "type": "object",
        "properties": {
          "teamcode": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "teamname": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "teamleaderid": {
            "type": "integer",
            "format": "int64"
          },
          "description": {
            "maxLength": 500,
            "minLength": 2,
            "type": "string"
          },
          "status": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MarketingTeamDetailInputDto"
            }
          }
        },
        "additionalProperties": false
      },
      "CreateSalesmanDto": {
        "required": [
          "email",
          "joiningdate",
          "mobileno",
          "salesmancode",
          "salesmanname"
        ],
        "type": "object",
        "properties": {
          "salesmancode": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "salesmanname": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "mobileno": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[0-9]{7,15}$",
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "joiningdate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MarketingTeamDetailInputDto": {
        "required": [
          "role",
          "salesmanid"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "salesmanid": {
            "type": "integer",
            "format": "int64"
          },
          "role": {
            "maximum": 4,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "targetamount": {
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "status": {
            "maximum": 2,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ProcessDeactivationRequestDto": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateMarketingTeamDto": {
        "required": [
          "description",
          "members",
          "teamleaderid",
          "teamname"
        ],
        "type": "object",
        "properties": {
          "teamname": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "teamleaderid": {
            "type": "integer",
            "format": "int64"
          },
          "description": {
            "maxLength": 500,
            "minLength": 2,
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MarketingTeamDetailInputDto"
            }
          }
        },
        "additionalProperties": false
      },
      "UpdateSalesmanDto": {
        "required": [
          "email",
          "joiningdate",
          "mobileno",
          "salesmanname"
        ],
        "type": "object",
        "properties": {
          "salesmanname": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "mobileno": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[0-9]{7,15}$",
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "joiningdate": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      }
    }
  }
